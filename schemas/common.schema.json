{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:visual-skill:common:v0.1.0",
  "title": "Visual Skill common types",
  "$defs": {
    "SemanticPath": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "TargetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "path"],
      "properties": {
        "domain": {
          "enum": ["subject", "scene", "composition", "color", "typography", "material", "lighting", "mood", "output"]
        },
        "path": {
          "enum": [
            "subject.identity",
            "subject.count",
            "subject.appearance",
            "subject.pose",
            "subject.relationships",
            "scene.landmark",
            "scene.location",
            "scene.objects",
            "scene.date",
            "composition.spatial_relationships",
            "composition.framing",
            "composition.negative_space",
            "color.palette",
            "color.accent",
            "typography.content",
            "typography.language",
            "material.texture",
            "lighting.direction",
            "lighting.mood",
            "mood.tone",
            "output.aspect_ratio"
          ]
        },
        "subject_ref": {"type": "string", "minLength": 1}
      }
    },
    "Diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
        "severity": {"enum": ["info", "warning", "error"]},
        "message": {"type": "string", "minLength": 1},
        "path": {"type": "string"}
      }
    },
    "Condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "op"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "op": {"const": "exists"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "op", "value"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "op": {"enum": ["eq", "neq", "gt", "gte", "lt", "lte", "in", "not_in"]},
            "value": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["all"],
          "properties": {
            "all": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Condition"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["any"],
          "properties": {
            "any": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Condition"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["not"],
          "properties": {
            "not": {"$ref": "#/$defs/Condition"}
          }
        }
      ]
    },
    "Action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "path", "value"],
      "properties": {
        "op": {"enum": ["set", "append"]},
        "path": {"type": "string", "pattern": "^plan\\."},
        "value": {}
      }
    },
    "Rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "priority", "when", "then"],
      "properties": {
        "rule_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
        "priority": {"type": "integer", "minimum": 0, "maximum": 1000},
        "description": {"type": "string"},
        "when": {"$ref": "#/$defs/Condition"},
        "then": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Action"}}
      }
    }
  }
}
