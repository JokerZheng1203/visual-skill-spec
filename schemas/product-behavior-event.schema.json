{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:visual-skill:product-behavior-event:v0.1.0",
  "title": "ProductBehaviorEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "output_id", "event_type", "occurred_at"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "output_id": {"type": "string", "minLength": 1},
    "event_type": {"enum": ["save", "share", "download", "retry"]},
    "occurred_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"},
    "channel": {"type": "string"}
  }
}
