{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:visual-skill:analysis-policy:v0.1.0",
  "title": "AnalysisPolicy",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_id", "minimum_confidence"],
  "properties": {
    "profile_id": {"type": "string", "minLength": 1},
    "minimum_confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation", "inference"],
      "properties": {
        "observation": {"type": "number", "minimum": 0, "maximum": 1},
        "inference": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
